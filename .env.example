# SQLite 本地演示。生产可改为 Postgres，见 README「切换 Postgres」。
DATABASE_URL="file:./dev.db"

# WhatsApp Cloud API。留空则进入 DEMO/MOCK 模式（收件箱可手工注入，不会真实外发）。
WA_PHONE_NUMBER_ID=""
WA_ACCESS_TOKEN=""
WA_VERIFY_TOKEN="farmboxer-demo-verify"
WA_BUSINESS_ACCOUNT_ID=""
WA_APP_SECRET=""

# 可选：OpenAI 兼容接口，用于草稿润色。缺失时使用规则/模板回复。
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# 毛利底线（百分比）。报价与自动回复必须遵守。
MARGIN_FLOOR_PERCENT="15"
